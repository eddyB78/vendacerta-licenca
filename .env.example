# Servidor
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET=troque_por_uma_string_secreta_longa_e_aleatoria_aqui

# Admin API
ADMIN_TOKEN=troque_por_um_token_secreto_para_o_painel_admin

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-xxxx
MP_WEBHOOK_SECRET=seu_webhook_secret

# URL do servidor (pública)
